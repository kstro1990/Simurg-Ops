# AI Agent Harness CLI — Environment Variables
# Copy this file to .env and fill in the API keys for the providers you want to use.

# Google Gemini
GEMINI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4o, etc.)
OPENAI_API_KEY=

# GitHub (Copilot CLI)
GITHUB_TOKEN=

# Opcional: si lo defines, el CLI publica su progreso en el monitor en vivo de
# la web (pestaña "En vivo"). Sin esta variable no intenta ninguna conexión.
HARNESS_EVENTS_URL=http://localhost:3000
