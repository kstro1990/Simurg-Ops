# Copia este fichero a `.env` y rellena solo las claves que vayas a usar.
# Las claves configuradas desde la UI se guardan en data/settings.json y tienen
# prioridad sobre estas; estas sirven como respaldo del servidor y para el CLI.

# Google Gemini
GEMINI_API_KEY=

# Anthropic (Claude Opus 5 / Sonnet 5 / Haiku 4.5)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4o, GPT-4o mini)
OPENAI_API_KEY=

# GitHub (ruta Copilot)
GITHUB_TOKEN=

# Opcional: si lo defines, /api/telegram/webhook exige la cabecera
# X-Telegram-Bot-Api-Secret-Token con este valor. Regístralo al configurar el
# webhook en Telegram con el parámetro `secret_token`.
TELEGRAM_WEBHOOK_SECRET=
